{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acie.example/schemas/mission.schema.json",
  "title": "ACIE Mission",
  "type": "object",
  "required": ["mission_id", "schema_version", "title", "objective", "success_criteria", "constraints", "autonomy", "resource_budget", "status"],
  "properties": {
    "mission_id": {"type": "string", "minLength": 8, "maxLength": 128},
    "schema_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "objective": {"type": "string", "minLength": 1},
    "success_criteria": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["criterion_id", "description", "verification_method"], "properties": {"criterion_id": {"type": "string"}, "description": {"type": "string"}, "verification_method": {"type": "string"}, "mandatory": {"type": "boolean", "default": true}}, "additionalProperties": false}},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "autonomy": {"type": "object", "required": ["level", "allowed_actions", "approval_required_for"], "properties": {"level": {"enum": ["MANUAL", "GUARDED", "AUTONOMOUS", "FULL"]}, "allowed_actions": {"type": "array", "items": {"type": "string"}}, "approval_required_for": {"type": "array", "items": {"type": "string"}}, "target_scope": {"type": "array", "items": {"type": "string"}}, "data_scope": {"type": "array", "items": {"type": "string"}}, "expires_at": {"type": "string", "format": "date-time"}}, "additionalProperties": false},
    "resource_budget": {"type": "object", "properties": {"max_tool_calls": {"type": "integer", "minimum": 0}, "max_duration_seconds": {"type": "integer", "minimum": 1}, "max_cost": {"type": "number", "minimum": 0}, "max_concurrency": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
    "requested_capabilities": {"type": "array", "items": {"type": "string"}},
    "owner": {"type": "string"},
    "status": {"enum": ["CREATED", "PLANNED", "QUEUED", "RUNNING", "WAITING_FOR_APPROVAL", "PAUSED", "COMPLETED", "PARTIALLY_COMPLETED", "BLOCKED", "FAILED", "CANCELLED", "SUPERSEDED"]},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}