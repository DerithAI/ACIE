{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acie.example/schemas/governance-decision.schema.json",
  "title": "ACIE Governance Decision",
  "type": "object",
  "required": ["decision_id", "proposal_digest", "policy_version", "outcome", "decided_at", "reason_codes"],
  "properties": {
    "decision_id": {"type": "string"},
    "proposal_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "policy_version": {"type": "string"},
    "outcome": {"enum": ["ALLOW", "ALLOW_WITH_CONDITIONS", "REQUIRE_APPROVAL", "DENY", "REVISE", "ESCALATE"]},
    "decided_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "reason_codes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "conditions": {"type": "array", "items": {"type": "string"}},
    "approval_ref": {"type": "string"},
    "audit_ref": {"type": "string"}
  },
  "additionalProperties": false
}